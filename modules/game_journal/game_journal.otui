JournalScrollBar < UIScrollBar
  orientation: vertical
  step: 20
  width: 10
  image-source: /game_journal/images/scroll_track
  image-border: 4
  pixels-scroll: true
  parent-scroll: true

  UIButton
    id: decrementButton
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    size: 10 10
    image-source: /game_journal/images/scroll_up
    image-clip: 0 0 10 10
    $hover:
      image-clip: 10 0 10 10

  UIButton
    id: incrementButton
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    size: 10 10
    image-source: /game_journal/images/scroll_down
    image-clip: 0 0 10 10
    $hover:
      image-clip: 10 0 10 10

  UIButton
    id: sliderButton
    anchors.centerIn: parent
    size: 10 30
    image-source: /game_journal/images/scroll_slider
    image-clip: 0 0 10 30
    image-border-top: 6
    image-border-bottom: 6
    $hover:
      image-clip: 10 0 10 30

AtlasRegion < UIWidget
  height: 22
  margin-top: 6
  image-border: 1
  image-source: /game_journal/images/row_off
  $hover:
    image-source: /game_journal/images/row_hover

  UIWidget
    id: arrow
    size: 9 9
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 3
    margin-bottom: 5
    image-source: /game_journal/images/atlas/arrow_closed
    phantom: true

  Label
    id: name
    anchors.left: arrow.right
    anchors.right: count.left
    anchors.bottom: parent.bottom
    margin-left: 5
    margin-bottom: 1
    font: verdana-11px-antialised
    color: #7a1e12
    text-auto-resize: false
    phantom: true

  Label
    id: count
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 6
    margin-bottom: 1
    width: 50
    text-align: right
    font: verdana-11px-antialised-italic
    color: #7a5a3a
    phantom: true

  UIWidget
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #a0784a80
    phantom: true

AtlasPlace < UIWidget
  height: 22
  focusable: true
  margin-bottom: 1
  image-border: 1
  image-source: /game_journal/images/row_off
  $hover:
    image-source: /game_journal/images/row_hover
  $focus:
    image-source: /game_journal/images/row_on

  UIWidget
    id: icon
    size: 14 14
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 16
    phantom: true

  Label
    id: title
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-antialised
    color: #3b2414
    text-auto-resize: false
    phantom: true

AtlasUnknown < UIWidget
  height: 20
  phantom: true

  UIWidget
    id: icon
    size: 14 14
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 16
    image-source: /game_journal/images/atlas/unknown
    phantom: true

  Label
    id: text
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-antialised-italic
    color: #9a8064
    phantom: true

AtlasSketch < UIWidget
  size: 276 152
  phantom: true

  UIWidget
    id: map
    anchors.centerIn: parent
    size: 264 144
    phantom: true

  UIWidget
    id: frame
    anchors.centerIn: parent
    size: 270 150
    image-source: /game_journal/images/atlas/frame
    image-border: 3
    phantom: true

AtlasWhere < UIWidget
  height: 18
  margin-top: 6
  phantom: true

  UIWidget
    size: 14 14
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 1
    image-source: /game_journal/images/atlas/where
    phantom: true

  Label
    id: text
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 6
    font: verdana-11px-antialised-italic
    color: #6a1a10
    text-wrap: true
    text-auto-resize: true
    phantom: true

AtlasRank < UIWidget
  height: 30
  margin-top: 2
  phantom: true

  UIWidget
    id: medal
    size: 24 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true

  Label
    id: name
    anchors.left: medal.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 0
    font: verdana-11px-antialised
    color: #3b2414
    phantom: true

  Label
    id: info
    anchors.left: name.left
    anchors.top: name.bottom
    margin-top: 1
    font: verdana-11px-antialised-italic
    color: #7a5a3a
    phantom: true

  UIWidget
    id: mark
    size: 14 14
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    phantom: true

JournalRibbon < UIButton
  size: 100 30
  image-source: /game_journal/images/tab
  font: verdana-11px-antialised
  color: #e6cfa0
  text-align: center
  text-offset: 0 3
  $hover !on:
    image-source: /game_journal/images/tab_hover
    color: #fff0d0
  $on:
    image-source: /game_journal/images/tab_on
    color: #6a1a10
    text-offset: 0 1

JournalRow < UIWidget
  height: 32
  focusable: true
  margin-bottom: 1
  image-border: 1
  image-source: /game_journal/images/row_off
  $hover:
    image-source: /game_journal/images/row_hover
  $focus:
    image-source: /game_journal/images/row_on

  UIWidget
    id: icon
    size: 24 24
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    phantom: true

  Label
    id: title
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 2
    font: verdana-11px-antialised
    color: #3b2414
    text-auto-resize: false
    phantom: true

  Label
    id: sub
    anchors.left: title.left
    anchors.right: parent.right
    anchors.top: title.bottom
    margin-top: 1
    font: verdana-11px-antialised-italic
    color: #7a5a3a
    phantom: true

JournalRegion < UIWidget
  height: 22
  margin-top: 6
  phantom: true

  Label
    id: name
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    margin-left: 4
    font: verdana-11px-antialised
    color: #7a1e12
    phantom: true

  Label
    id: count
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-right: 6
    font: verdana-11px-antialised-italic
    color: #7a5a3a
    phantom: true

  UIWidget
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 1
    background-color: #a0784a80
    phantom: true

JournalText < Label
  font: verdana-11px-antialised
  color: #3b2414
  text-wrap: true
  text-auto-resize: true
  text-align: topLeft
  phantom: true

JournalNote < UIWidget
  phantom: true
  height: 20
  margin-top: 6

  UIWidget
    id: mark
    size: 14 14
    anchors.left: parent.left
    anchors.top: parent.top
    margin-top: 1
    phantom: true

  Label
    id: text
    anchors.left: mark.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 6
    font: verdana-11px-antialised-italic
    color: #4a2e18
    text-wrap: true
    text-auto-resize: true
    text-align: topLeft
    phantom: true

JournalWindow < UIWindow
  id: journalWindow
  size: 760 532
  anchors.centerIn: parent
  @onEscape: modules.game_journal.hide()

  UIWidget
    id: book
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    size: 760 500
    image-source: /game_journal/images/book
    phantom: true

  JournalRibbon
    id: tab_seals
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 40
    margin-top: 4
    !text: tr('Five Seals')
    @onClick: modules.game_journal.selectTab('seals')

  JournalRibbon
    id: tab_rook
    anchors.left: tab_seals.right
    anchors.top: tab_seals.top
    margin-left: 4
    !text: tr('Rookgaard')
    @onClick: modules.game_journal.selectTab('rook')

  JournalRibbon
    id: tab_library
    anchors.left: tab_rook.right
    anchors.top: tab_seals.top
    margin-left: 4
    !text: tr('Library')
    @onClick: modules.game_journal.selectTab('library')

  JournalRibbon
    id: tab_chronicle
    anchors.left: tab_library.right
    anchors.top: tab_seals.top
    margin-left: 4
    !text: tr('Chronicle')
    @onClick: modules.game_journal.selectTab('chronicle')

  JournalRibbon
    id: tab_atlas
    anchors.left: tab_chronicle.right
    anchors.top: tab_seals.top
    margin-left: 4
    !text: tr('Atlas')
    @onClick: modules.game_journal.selectTab('atlas')

  JournalRibbon
    id: tab_talk
    anchors.left: tab_atlas.right
    anchors.top: tab_seals.top
    margin-left: 4
    !text: tr('Hearsay')
    @onClick: modules.game_journal.selectTab('talk')

  UIButton
    id: closeButton
    anchors.right: parent.right
    anchors.top: parent.top
    margin-right: 24
    margin-top: 4
    size: 30 30
    image-source: /game_journal/images/close
    image-clip: 0 0 30 30
    $hover:
      image-clip: 30 0 30 30
    @onClick: modules.game_journal.hide()

  Label
    id: chapterTitle
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 50
    margin-top: 66
    width: 310
    font: Verdana Bold-13px
    color: #6a1a10
    text-align: center
    phantom: true

  Label
    id: chapterSub
    anchors.left: chapterTitle.left
    anchors.top: chapterTitle.bottom
    width: 310
    margin-top: 2
    font: verdana-11px-antialised-italic
    color: #7a5a3a
    text-align: center
    phantom: true

  UIWidget
    id: chapterRule
    anchors.horizontalCenter: chapterTitle.horizontalCenter
    anchors.top: chapterSub.bottom
    margin-top: 4
    size: 300 9
    image-source: /game_journal/images/rule
    phantom: true

  UIWidget
    id: atlasSummary
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 46
    margin-top: 112
    size: 312 56
    image-border: 1
    image-source: /game_journal/images/row_off
    visible: false
    $hover:
      image-source: /game_journal/images/row_hover

    UIWidget
      id: atlasMedal
      size: 44 44
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 4
      phantom: true

    Label
      id: atlasRank
      anchors.left: atlasMedal.right
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 8
      margin-top: 5
      font: verdana-11px-antialised
      color: #6a1a10
      text-auto-resize: false
      phantom: true

    Label
      id: atlasPlacesText
      anchors.left: atlasRank.left
      anchors.right: parent.right
      anchors.top: atlasRank.bottom
      margin-top: 2
      font: verdana-11px-antialised
      color: #3b2414
      text-auto-resize: false
      phantom: true

    Label
      id: atlasNext
      anchors.left: atlasRank.left
      anchors.right: parent.right
      anchors.top: atlasPlacesText.bottom
      margin-top: 2
      font: verdana-11px-antialised-italic
      color: #7a5a3a
      text-auto-resize: false
      phantom: true

  UIWidget
    id: atlasRule
    anchors.horizontalCenter: chapterTitle.horizontalCenter
    anchors.top: atlasSummary.bottom
    margin-top: 2
    size: 300 9
    image-source: /game_journal/images/rule
    visible: false
    phantom: true

  ScrollablePanel
    id: entries
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 50
    margin-top: 118
    size: 300 362
    layout:
      type: verticalBox
    vertical-scrollbar: entriesScroll

  JournalScrollBar
    id: entriesScroll
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 354
    margin-top: 118
    height: 362

  UIWidget
    id: pageSeal
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 412
    margin-top: 60
    size: 44 44
    phantom: true

  Label
    id: pageTitle
    anchors.left: pageSeal.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 64
    width: 252
    font: Verdana Bold-13px
    color: #6a1a10
    text-wrap: true
    text-auto-resize: true
    phantom: true

  Label
    id: pageSub
    anchors.left: pageTitle.left
    anchors.top: pageTitle.bottom
    width: 252
    margin-top: 2
    font: verdana-11px-antialised-italic
    color: #7a5a3a
    phantom: true

  UIWidget
    id: pageRule
    anchors.left: parent.left
    anchors.top: pageSub.bottom
    margin-left: 410
    margin-top: 4
    size: 300 9
    image-source: /game_journal/images/rule
    phantom: true

  ScrollablePanel
    id: page
    anchors.left: parent.left
    anchors.top: pageRule.bottom
    anchors.bottom: parent.bottom
    margin-left: 418
    margin-top: 6
    margin-bottom: 90
    width: 282
    layout:
      type: verticalBox
    vertical-scrollbar: pageScroll

  JournalScrollBar
    id: pageScroll
    anchors.left: parent.left
    anchors.top: pageRule.bottom
    anchors.bottom: parent.bottom
    margin-left: 704
    margin-top: 6
    margin-bottom: 90

  Label
    id: pageStatus
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 418
    margin-top: 452
    width: 220
    font: verdana-11px-antialised
    color: #6a1a10
    phantom: true

  UIButton
    id: prevButton
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 640
    margin-top: 448
    size: 30 22
    image-source: /game_journal/images/prev
    image-clip: 0 0 30 22
    $hover:
      image-clip: 30 0 30 22
    @onClick: modules.game_journal.step(-1)

  UIButton
    id: nextButton
    anchors.left: prevButton.right
    anchors.top: prevButton.top
    margin-left: 2
    size: 30 22
    image-source: /game_journal/images/next
    image-clip: 0 0 30 22
    $hover:
      image-clip: 30 0 30 22
    @onClick: modules.game_journal.step(1)
